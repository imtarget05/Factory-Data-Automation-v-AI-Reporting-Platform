# Image chỉ phục vụ API (`app.api.main:app`), không phục vụ dashboard.
#
# Vì sao KHÔNG dùng requirements.txt của repo: nó kéo streamlit, reportlab
# UI, faker, apscheduler... — hàng trăm MB cho một API chỉ cần pandas và
# fastapi. Image nhỏ hơn nhiều, pull nhanh hơn, cold start ngắn hơn.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Deps cài trước khi copy source: layer này được cache lại khi chỉ code đổi,
# nên rebuild sau đó không phải cài lại pandas.
COPY requirements.api.txt ./
RUN pip install --no-cache-dir -r requirements.api.txt

COPY app/ ./app/
COPY data/ ./data/
COPY scripts/ ./scripts/

# `data/raw/*` is gitignored (see .gitignore), so a clone contains only
# .gitkeep and `COPY data/` above ships an empty source dir. That is what
# deployed: /api/v1/health reported data_loaded=true on an empty dict while
# /api/v1/kpis, /api/v1/alerts and /api/v1/report all returned 500.
#
# Generate the fixture into the image so the container is self-contained.
# Faker is needed only by the generator (supplier names) and is therefore
# installed and removed in the same layer — it never reaches the runtime
# image, and requirements.api.txt stays minimal.
RUN pip install --no-cache-dir --retries 5 --timeout 60 faker \
    && python -m scripts.generate_sample_data \
    && test -n "$(ls -A data/raw/*.csv 2>/dev/null)" \
    && pip uninstall -y faker

# User không phải root. Không chỉ để `runAsNonRoot` không từ chối: image chạy
# bằng UID 0 là một lỗ hổng đã biết, không phải một cấu hình bị siết.
RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Healthcheck gọi đúng endpoint mà Kubernetes probe và Container Apps
# healthCheck sẽ gọi — không phải endpoint "chắc chắn còn sống".
HEALTHCHECK --interval=15s --timeout=5s --start-period=25s --retries=3 \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health',timeout=4)"

CMD ["python", "-m", "uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
